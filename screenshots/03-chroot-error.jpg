.376-4.096 304.426667-272.213333a42.666667 42.666667 0 0 0 2.986667-60.714667l-3.413334-3.285333-304.469333-264.277333z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Share</span></div> <div data-v-4c27bfac="" data-v-b1bd13bb="" class="assistant-page"><div data-v-1005b780="" data-v-4c27bfac="" class="icon-button assistant-page-item" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Left_b"><path d="M342.99904 549.23264a36.864 36.864 0 0 1 0.08192-52.0192l285.696-285.696a36.864 36.864 0 1 1 52.14208 52.10112l-259.6864 259.72736 259.76832 261.69344a36.864 36.864 0 0 1-52.30592 51.93728L342.99904 549.2736z" fill="currentColor"></path></svg> <!----></div> <span data-v-4c27bfac="" class="assistant-page-info">2/2</span> <div data-v-1005b780="" data-v-4c27bfac="" class="icon-button assistant-page-item disabled" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Right_b"><path d="M681.00096 549.23264a36.864 36.864 0 0 0-0.08192-52.0192L395.22304 211.47648a36.864 36.864 0 1 0-52.14208 52.10112l259.6864 259.72736-259.76832 261.69344a36.864 36.864 0 0 0 52.30592 51.93728l285.696-287.744z" fill="currentColor"></path></svg> <!----></div></div></div> <!----></div>   <!----> <!----> <!----> <!----></div></div></div></div><div data-v-38e35b58="" class="chat-content-item chat-content-item-assistant" data-archer-id="19f5cd9a-c5d2-8c3f-8000-0a16b4e23404"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-assistant"><div data-v-88be9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div class="paragraph" dir="auto">I understand — you want a clean Windows reset (keeping files) AND more space for Parrot. The "Could not find recovery environment" error is blocking the reset.</div><div class="paragraph" dir="auto">Let me search for the fix to this Windows reset error.</div></div></div><div data-v-004597db="" class="container-block"><div data-v-004597db="" class="block-item"><div data-v-d664c8c3=""><div data-v-863d6f1b="" data-v-d664c8c3="" class="toolcall-container default toolcall-web_search"><div data-v-bc9c95fe="" data-v-863d6f1b="" class="toolcall-title-container default"><div data-v-bc9c95fe="" class="toolcall-title-name"><svg data-v-bc9c95fe="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify toolcall-title-name-icon" width="1em" height="1em" viewBox="0 0 1024 1024" name="Search"><path d="M491.52 155.648a348.16 348.16 0 0 1 270.86848 566.8864l123.82208 123.86304a36.864 36.864 0 1 1-52.10112 52.10112l-123.86304-123.82208A348.16 348.16 0 1 1 491.52 155.648z m0 622.592a274.432 274.432 0 1 0 0-548.864 274.432 274.432 0 0 0 0 548.864z" fill="currentColor"></path></svg> <span data-v-bc9c95fe="" class="toolcall-title-name-text">Search</span></div> <span data-v-bc9c95fe="" class="toolcall-title-container-content"><span data-v-bc9c95fe="" class="toolcall-title-container-text">Windows
 10 11 reset could not find recovery environment fix 2026 reset PC could
 not find recovery environment insert installation media</span> </span> <div data-v-bc9c95fe="" class="toolcall-title-container-extra"><span data-v-863d6f1b="" need-upgrade="false">12 results</span> <svg data-v-bc9c95fe="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify toolcall-title-container-extra-arrow" width="1em" height="1em" viewBox="0 0 1024 1024" name="Right_b"><path d="M681.00096 549.23264a36.864 36.864 0 0 0-0.08192-52.0192L395.22304 211.47648a36.864 36.864 0 1 0-52.14208 52.10112l259.6864 259.72736-259.76832 261.69344a36.864 36.864 0 0 0 52.30592 51.93728l285.696-287.744z" fill="currentColor"></path></svg></div></div> <!----></div></div></div></div> <!----> <!----><!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">I found the fix! The "Could not find recovery environment" error means **Windows Recovery Environment (WinRE) is disabled**. Here's how to fix it:</code></pre></div></div> <div data-v-d664c8c3=""></div><hr><h2>Fix: Enable Windows Recovery Environment</h2><h3>Step 1: Check WinRE Status</h3><div class="paragraph" dir="auto">In Windows, open <strong>Command Prompt as Administrator</strong>:</div><ol start="1"><li><div class="paragraph" dir="auto">Press <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">Win + S</code>, type <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">cmd</code></div></li><li><div class="paragraph" dir="auto">Right-click <strong>Command Prompt</strong> → <strong>Run as administrator</strong></div></li><li><div class="paragraph" dir="auto">Type:</div></li></ol><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">cmd</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-cmd"><code class="language-cmd">reagentc /info</code></pre></div></div> <div data-v-d664c8c3=""></div><ol start="4"><li><div class="paragraph" dir="auto">Look for <strong>"Windows RE status"</strong></div></li></ol><div class="paragraph" dir="auto">If it says <strong>Disabled</strong>, that's the problem!</div><hr><h3>Step 2: Enable WinRE</h3><div class="paragraph" dir="auto">In the same Command Prompt, type:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">cmd</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-cmd"><code class="language-cmd">reagentc /enable</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">If it says <strong>"Operation successful"</strong>, you're good! Try resetting Windows again.</div><hr><h3>Step 3: If Enabling Fails</h3><div class="paragraph" dir="auto">Run these commands one by one:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">cmd</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-cmd"><code class="language-cmd">sfc /scannow</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Wait for it to finish, then:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">cmd</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-cmd"><code class="language-cmd">DISM /Online /Cleanup-Image /RestoreHealth</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Wait for it to finish, then try again:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">cmd</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-cmd"><code class="language-cmd">reagentc /enable</code></pre></div></div> <div data-v-d664c8c3=""></div><hr><h3>Step 4: Try Reset Again</h3><ol start="1"><li><div class="paragraph" dir="auto">Press <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">Win + I</code> → <strong>Settings → System → Recovery</strong></div></li><li><div class="paragraph" dir="auto">Click <strong>Reset this PC</strong> → <strong>Get started</strong></div></li><li><div class="paragraph" dir="auto">Choose <strong>"Keep my files"</strong></div></li><li><div class="paragraph" dir="auto">It should work now!</div></li></ol><hr><h2>If It Still Doesn't Work</h2><div class="paragraph" dir="auto">Use <strong>Windows Installation Media</strong> to reset:</div><ol start="1"><li><div class="paragraph" dir="auto">On another PC, go to <a data-v-3b9ae98b="" target="_blank" href="https://www.microsoft.com/software-download/windows11" rel="noreferrer nofollow noopener">Microsoft Windows Download</a></div></li><li><div class="paragraph" dir="auto">Download <strong>Media Creation Tool</strong></div></li><li><div class="paragraph" dir="auto">Create a bootable USB</div></li><li><div class="paragraph" dir="auto">Boot from USB on your laptop</div></li><li><div class="paragraph" dir="auto">Click <strong>"Repair your computer"</strong> (bottom left)</div></li><li><div class="paragraph" dir="auto">Go to <strong>Troubleshoot → Reset this PC → Keep my files</strong></div></li></ol><hr><div class="paragraph" dir="auto"><strong>Try Step 1 and 2 first!</strong> Open Command Prompt as admin and run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">reagentc /info</code>. Tell me what it shows! 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <!----></div><!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Refresh"><path d="M303.104 315.392c114.688-114.688 303.104-114.688 417.792 0l-32.768 32.768c-20.48 20.48-4.096 57.344 24.576 57.344h118.784c16.384 0 32.768-16.384 32.768-32.768V253.952c0-28.672-36.864-45.056-57.344-24.576l-32.768 32.768c-143.36-143.36-376.832-143.36-520.192 0s-143.36 376.832 0 520.192 376.832 143