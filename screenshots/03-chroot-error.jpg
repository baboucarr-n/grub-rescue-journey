x="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span> <div data-v-1005b780="" data-v-01af594f="" class="icon-button table-actions-icon" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Download"><path d="M512 126.976a36.864 36.864 0 0 1 36.864 36.864v347.91424l119.11168-119.11168a36.864 36.864 0 1 1 52.14208 52.14208l-182.0672 182.02624a36.864 36.864 0 0 1-52.10112 0l-182.0672-182.02624a36.864 36.864 0 0 1 52.14208-52.14208l119.11168 119.11168V163.84a36.864 36.864 0 0 1 36.864-36.864zM184.32 564.71552a36.864 36.864 0 0 1 36.864 36.864v145.65376a35.96288 35.96288 0 0 0 35.96288 35.96288h509.70624a35.96288 35.96288 0 0 0 35.96288-35.96288v-145.65376a36.864 36.864 0 0 1 73.728 0v145.65376a109.69088 109.69088 0 0 1-109.69088 109.69088H257.14688A109.69088 109.69088 0 0 1 147.456 747.23328v-145.65376a36.864 36.864 0 0 1 36.864-36.864z" fill="currentColor"></path></svg> <!----></div><!----></div></header></div></div></div> <div data-v-01af594f="" class="table-container"><table data-v-01af594f=""><thead data-v-01af594f=""><tr data-v-01af594f=""><th data-v-01af594f="" align="left">Partition</th><th data-v-01af594f="" align="left">Type</th><th data-v-01af594f="" align="left">Size</th><th data-v-01af594f="" align="left">Status</th></tr></thead> <tbody data-v-01af594f=""><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P FAT12</code></td><td data-v-01af594f="" align="left">2898 sectors</td><td data-v-01af594f="" align="left">~1.4MB</td><td data-v-01af594f="" align="left">EFI System Partition</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P Linux</code></td><td data-v-01af594f="" align="left">110614528 sectors</td><td data-v-01af594f="" align="left">~53GB</td><td data-v-01af594f="" align="left">[writable]</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">D Linux</code></td><td data-v-01af594f="" align="left">14683347 sectors</td><td data-v-01af594f="" align="left">~7GB</td><td data-v-01af594f="" align="left">Deleted</td></tr></tbody></table></div></div><div class="paragraph" dir="auto">The <strong>P Linux</strong> partition (53GB, marked [writable]) is likely your old data partition! The <strong>D Linux</strong> is a deleted one.</div><hr><h2>Next Steps</h2><h3>Step 1: Check Files in the P Linux Partition</h3><ol start="1"><li><div class="paragraph" dir="auto">Use <strong>Arrow keys</strong> to select the <strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P Linux</code></strong> partition (the big one, 110614528 sectors)</div></li><li><div class="paragraph" dir="auto">Press <strong>P</strong> to <strong>list files</strong></div></li><li><div class="paragraph" dir="auto">Check if your files are there!</div></li></ol><div class="paragraph" dir="auto">If you see your files, that's the right partition!</div><hr><h3>Step 2: If Files Are Correct</h3><ol start="1"><li><div class="paragraph" dir="auto">Press <strong>Q</strong> to go back</div></li><li><div class="paragraph" dir="auto">Make sure <strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P Linux</code></strong> is selected</div></li><li><div class="paragraph" dir="auto">Press <strong>Enter</strong> to continue</div></li><li><div class="paragraph" dir="auto">Select <strong>Write</strong> to restore the partition table</div></li><li><div class="paragraph" dir="auto">Confirm <strong>Yes</strong></div></li><li><div class="paragraph" dir="auto">Reboot</div></li></ol><hr><h3>Step 3: If Files Are NOT There</h3><div class="paragraph" dir="auto">Try the other partitions:</div><ul start="1"><li><div class="paragraph" dir="auto">Select <strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">D Linux</code></strong> and press <strong>P</strong> to check files</div></li><li><div class="paragraph" dir="auto">Or select <strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P FAT12</code></strong> and press <strong>P</strong></div></li></ul><hr><h2>Do This Now</h2><div class="paragraph" dir="auto"><strong>Select <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P Linux</code> (the 110614528 sectors one) and press P to list files.</strong></div><div class="paragraph" dir="auto">Tell me what you see — are your files there? 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class=