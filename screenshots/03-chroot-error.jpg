-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-user-action-row"><div data-v-b1bd13bb="" class="segment-user-actions"> <div data-v-351fdc4e="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Edit"><path d="M736.085333 222.592a46.165333 46.165333 0 0 1 65.322667 65.28L336.426667 752.938667a132.266667 132.266667 0 0 1-61.44 34.773333l-51.541334 12.885333 12.885334-51.541333a132.266667 132.266667 0 0 1 34.773333-61.44L736.085333 222.592z m32.682667-90.325333c-32.64 0-63.914667 12.970667-86.997333 36.010666L216.832 633.258667a209.066667 209.066667 0 0 0-55.04 97.152l-28.373333 113.621333a38.4 38.4 0 0 0 46.549333 46.549333l113.621333-28.416a209.066667 209.066667 0 0 0 97.152-54.997333l361.813334-361.813333 103.168-103.125334A122.965333 122.965333 0 0 0 768.768 132.266667zM512 814.933333a38.4 38.4 0 1 0 0 76.8h298.666667a38.4 38.4 0 1 0 0-76.8h-298.666667z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Edit</span></div> <div data-v-351fdc4e="" data-v-92afdd37="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 16