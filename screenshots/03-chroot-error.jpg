="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <div data-v-d3915d44="" data-v-d664c8c3="" class="user-content"><!----> I just want to reset the windows (while leaving some files) and create more space, because I want to do so more on my parrot</div> <!----> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-user-action-row"><div data-v-b1bd13bb="" class="segment-user-actions"> <div data-v-351fdc4e="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Edit"><path d="M736.085333 222.592a46.165333 46.165333 0 0 1 65.322667 65.28L336.426667 752.938667a132.266667 132.266667 0 0 1-61.44 34.773333l-51.541334 12.885333 12.885334-51.541333a132.266667 132.266667 0 0 1 34.773333-61.44L736.085333 222.592z m32.682667-90.325333c-32.64 0-63.914667 12.970667-86.997333 36.010666L216.832 633.258667a209.066667 209.066667 0 0 0-55.04 97.152l-28.373333 113.621333a38.4 38.4 0 0 0 46.549333 46.549333l113.621333-28.416a209.066667 209.066667 0 0 0 97.152-54.997333l361.813334-361.813333 103.168-103.125334A122.965333 122.965333 0 0 0 768.768 132.266667zM512 814.933333a38.4 38.4 0 1 0 0 76.8h298.666667a38.4 38.4 0 1 0 0-76.8h-298.666667z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Edit</span></div> <div data-v-351fdc4e="" data-v-92afdd37="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 102