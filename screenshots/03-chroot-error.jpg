.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">I can see the files in the `P Linux` partition:</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-01af594f="" data-v-3b9ae98b="" class="table markdown-table"><div data-v-13fde6a9="" data-v-01af594f="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-01af594f="" class="table-actions"><div data-v-01af594f="" class="table-actions-content"><span data-v-01af594f="" class="table-title">Table</span> <span data-v-868ea423="" data-v-01af594f=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span> <div data-v-1005b780="" data-v-01af594f="" class="icon-button table-actions-icon" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Download"><path d="M512 126.976a36.864 36.864 0 0 1 36.864 36.864v347.91424l119.11168-119.11168a36.864 36.864 0 1 1 52.14208 52.14208l-182.0672 182.02624a36.864 36.864 0 0 1-52.10112 0l-182.0672-182.02624a36.864 36.864 0 0 1 52.14208-52.14208l119.11168 119.11168V163.84a36.864 36.864 0 0 1 36.864-36.864zM184.32 564.71552a36.864 36.864 0 0 1 36.864 36.864v145.65376a35.96288 35.96288 0 0 0 35.96288 35.96288h509.70624a35.96288 35.96288 0 0 0 35.96288-35.96288v-145.65376a36.864 36.864 0 0 1 73.728 0v145.65376a109.69088 109.69088 0 0 1-109.69088 109.69088H257.14688A109.69088 109.69088 0 0 1 147.456 747.23328v-145.65376a36.864 36.864 0 0 1 36.864-36.864z" fill="currentColor"></path></svg> <!----></div><!----></div></header></div></div></div> <div data-v-01af594f="" class="table-container"><table data-v-01af594f=""><thead data-v-01af594f=""><tr data-v-01af594f=""><th data-v-01af594f="" align="left">File/Folder</th><th data-v-01af594f="" align="left">Date</th></tr></thead> <tbody data-v-01af594f=""><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">.</code> (current dir)</td><td data-v-01af594f="" align="left">2-Jul-2026</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">..</code> (parent dir)</td><td data-v-01af594f="" align="left">2-Jul-2026</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">lost+found</code></td><td data-v-01af594f="" align="left">2-Jul-2026</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">install-logs-2026-07-02.0</code></td><td data-v-01af594f="" align="left">2-Jul-2026</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">install-logs-2026-07-02.1</code></td><td data-v-01af594f="" align="left">2-Jul-2026</td></tr></tbody></table></div></div><div class="paragraph" dir="auto">These look like <strong>SystemRescue installation logs</strong> from when you created the USB! This might be the SystemRescue partition, not your personal files.</div><hr><h2>Check for More Files</h2><div class="paragraph" dir="auto">Navigate deeper to see if your files are in subdirectories:</div><ol start="1"><li><div class="paragraph" dir="auto">Use <strong>Right Arrow</strong> key to enter a directory</div></li><li><div class="paragraph" dir="auto">Or press <strong>A</strong> to select all files, then <strong>C</strong> to copy them</div></li></ol><div class="paragraph" dir="auto">But first, let's check if there are more directories. Press <strong>Right Arrow</strong> on the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">install-logs...</code> folders or look for other directories.</div><div class="paragraph" dir="auto">Actually, this looks like it might be the <strong>SystemRescue boot partition</strong> (the ISO you flashed). Your personal files might be in a different location or on a different partition.</div><hr><h2>Let's Check the Other Partitions</h2><div class="paragraph" dir="auto">Press <strong>Q</strong> to go back, then check the other partitions:</div><ol start="1"><li><div class="paragraph" dir="auto">Press <strong>Q</strong> to quit file list</div></li><li><div class="paragraph" dir="auto">Select <strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">D Linux</code></strong> (the deleted one) and press <strong>P</strong></div></li><li><div class="paragraph" dir="auto">See if your files are there</div></li></ol><div class="paragraph" dir="auto">Or check if there's a way to see more directories in the current partition.</div><hr><h2>Alternative: This Might Not Be Your Data</h2><div class="paragraph" dir="auto">The dates (2-Jul-2026) match when you created the SystemRescue USB. Your personal files might have been on a different partition that got overwritten when you flashed the ISO.</div><div class="paragraph" dir="auto"><strong>Press Q to go back, then select D Linux and press P to check that partition.</strong> Tell me what you see! 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.