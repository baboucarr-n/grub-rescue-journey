2e62-8785-8000-0a16a25091d2"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-user"><!----> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <div data-v-65d6f9fd="" data-v-a660adc4="" class="attachment-list"><div data-v-65d6f9fd="" class="attachment-list-image single"><div data-v-c774e65a="" data-v-65d6f9fd="" class="image-thumbnail large loading"><div data-v-c774e65a="" class="image-mask"><div data-v-c774e65a="" class="loading-icon"></div></div> <span data-v-0fac845b="" data-v-c774e65a="" class="image-wrapper image-detail"><!----> <img data-v-0fac845b="" class="image-main is-cover" loading="lazy" alt=""> <!----></span> <!----></div></div> <!----></div> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <div data-v-d3915d44="" data-v-d664c8c3="" class="user-content"><!----> Check this</div> <!----> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-user-action-row"><div data-v-b1bd13bb="" class="segment-user-actions"> <div data-v-351fdc4e="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Edit"><path d="M736.085333 222.592a46.165333 46.165333 0 0 1 65.322667 65.28L336.426667 752.938667a132.266667 132.266667 0 0 1-61.44 34.773333l-51.541334 12.885333 12.885334-51.541333a132.266667 132.266667 0 0 1 34.773333-61.44L736.085333 222.592z m32.682667-90.325333c-32.64 0-63.914667 12.970667-86.997333 36.010666L216.832 633.258667a209.066667 209.066667 0 0 0-55.04 97.152l-28.373333 113.621333a38.4 38.4 0 0 0 46.549333 46.549333l113.621333-28.416a209.066667 209.066667 0 0 0 97.152-54.997333l361.813334-361.813333 103.168-103.125334A122.965333 122.965333 0 0 0 768.768 132.266667zM512 814.933333a38.4 38.4 0 1 0 0 76.8h298.666667a38.4 38.4 0 1 0 0-76.8h-298.666667z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Edit</span></div> <div data-v-351fdc4e="" data-v-92afdd37="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Copy</span></div> <div data-v-351fdc4e="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Share_a"><path d="M386.218667 247.850667c0-102.4 120.405333-157.397333 197.76-90.282667l304.426666 264.32a119.466667 119.466667 0 0 1 1.365334 179.285333l-304.469334 272.170667c-76.970667 68.778667-199.082667 14.122667-199.082666-89.088v-89.173333c-33.024 2.261333-59.306667 6.826667-83.2 15.36-30.592 10.88-61.866667 29.952-98.602667 67.712a76.8 76.8 0 0 1-131.84-53.504c0-98.645333 24.106667-190.976 83.712-261.888 55.253333-65.792 133.973333-104.789333 229.930667-117.845334V247.850667z m147.413333-32.256c-27.648-23.978667-70.613333-4.352-70.613333 32.256v126.208l-0.256 4.309333c-2.218667 21.504-20.437333 38.186667-42.410667 40.021333l-17.194667 1.706667c-173.994667 20.949333-253.824 136.405333-253.824 304.554667 86.997333-89.557333 163.925333-105.386667 270.933334-107.861334a42.026667 42.026667 0 0 1 42.752 42.24v125.226667c0 34.56 38.272 53.845333 65.706666 35.925333l5.376-4.096 304.426667-272.213333a42.666667 42.666667 0 0 0 2.986667-60.714667l-3.413334-3.285333-304.469333-264.277333z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Share</span></div> <!----></div> <!----></div>   <!----> <!----> <!----> <!----></div></div></div></div><div data-v-38e35b58="" class="chat-content-item chat-content-item-assistant" data-archer-id="19f24bca-2e62-8785-8000-0a16c9ad0e03"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-assistant"><div data-v-88be9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div class="paragraph" dir="auto">I can see the issue now! Looking at the screenshot:</div><ol start="1"><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> failed with <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount: /mnt/parrot/dev: target is busy.</code> - The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> mount is busy and can't be unmounted.</div></li><li><div class="paragraph" dir="auto">The user also ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --make-rslave /mnt/parrot/dev</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount -t sysfs sysfs /mnt/parrot/sys</code> - but the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> still failed with the same error.</div></li></ol><div class="paragraph" dir="auto">The problem is that SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> is fundamentally broken (missing <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc/sys/kernel/random/boot_id</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc/sys/kernel/random/uuid</code>), and binding it into the chroot doesn't help because the device nodes inside <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> depend on a working <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code>.</div><div class="paragraph" dir="auto">Let me think of a different approach:</div><div class="paragraph" dir="auto"><strong>Option 1: Use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> WITHOUT chroot</strong>
Instead of chrooting, we can run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from SystemRescue directly, pointing it to the correct boot directory and EFI directory.</div><div class="paragraph" dir="auto">The command would be:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install --boot-directory<span class="token operator">=</span>/mnt/parrot/boot --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi <span class="token parameter variable">--removable</span> /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Wait, but earlier in the context, the user tried something similar. Let me think more carefully.</div><div class="paragraph" dir="auto">Actually, looking at the error more carefully: "cannot find a device for /boot/grub (is /dev mounted?)". This error from <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> inside chroot means it can't find the device that corresponds to <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code>. This is because GRUB needs to know which physical device <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> is on, and it uses <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> to figure this out.</div><div class="paragraph" dir="auto">The issue is that inside the chroot, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> doesn't have the proper device nodes because SystemRescue uses a different device naming scheme or the devtmpfs isn't properly populated.</div><div class="paragraph" dir="auto"><strong>Option 2: Create device nodes manually</strong>
We could create the necessary device nodes in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code> manually.</div><div class="paragraph" dir="auto"><strong>Option 3: Use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from outside chroot with proper paths</strong>
This is probably the best approach. Instead of chrooting, we run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from SystemRescue's environment, telling it where the Parrot system's boot files are.</div><div class="paragraph" dir="auto">The key insight is that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> has a <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--root-directory</code> option (or we can use the combination of <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--boot-directory</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--efi-directory</code>).</div><div class="paragraph" dir="auto">Actually, let me reconsider. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> command from SystemRescue should be able to install GRUB if we tell it the right paths. But we also need to update the GRUB config, which requires running <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">update-grub</code> inside the chroot or <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> from outside.</div><div class="paragraph" dir="auto">Let me think about the best approach:</div><ol start="1"><li><div class="paragraph" dir="auto">From outside chroot, run:</div></li></ol><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install --boot-directory<span class="token operator">=</span>/mnt/parrot/boot --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But this might have issues because <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> needs to know about the installed OS to create the right config.</div><ol start="2"><li><div class="paragraph" dir="auto">Or, we could try to fix the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> issue by mounting a proper devtmpfs:</div></li></ol><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">This would create a fresh devtmpfs with proper device nodes, independent of SystemRescue's broken <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code>.</div><div class="paragraph" dir="auto">Let me go with option 2 first - mount a fresh devtmpfs. This should give us proper device nodes inside the chroot.</div><div class="paragraph" dir="auto">Actually wait, the user already tried <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> and it failed because it's busy. We need to force unmount or use a different approach.</div><div class="paragraph" dir="auto">Let me try:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-l</span> /mnt/parrot/dev  <span class="token comment"># lazy unmount</span>
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Or we could just skip chroot entirely and use the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--root-directory</code> approach.</div><div class="paragraph" dir="auto">Actually, I think the cleanest solution is:</div><div class="paragraph" dir="auto"><strong>Approach A: Use devtmpfs</strong></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-l</span> /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev
<span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto"><strong>Approach B: Skip chroot, use --root-directory</strong></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install --root-directory<span class="token operator">=</span>/mnt/parrot /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--root-directory</code> is deprecated in newer GRUB. The modern approach is:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install --boot-directory<span class="token operator">=</span>/mnt/parrot/boot /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But this might not work for EFI systems because it needs the EFI directory too.</div><div class="paragraph" dir="auto">Actually, for EFI systems, the correct approach from outside chroot is:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi --boot-directory<span class="token operator">=</span>/mnt/parrot/boot <span class="token parameter variable">--removable</span> /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Hmm, but the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--removable</code> flag might not be what we want. Let me think...</div><div class="paragraph" dir="auto">Actually, the simplest and most reliable approach might be to just create the necessary device files manually in the chroot, or to use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mknod</code> to create <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code> and other needed devices.</div><div class="paragraph" dir="auto">But that's complicated. Let me try a different approach:</div><div class="paragraph" dir="auto"><strong>Use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> with <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--root-directory</code> or just fix the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> mount.</strong></div><div class="paragraph" dir="auto">Actually, I just realized something. The user ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code>. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--rbind</code> should have worked if SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> was proper. But SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> is a <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> that might not have all the device nodes because the kernel's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> are broken in this environment.</div><div class="paragraph" dir="auto">The best fix is to mount a fresh <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> in the chroot. But first we need to unmount the existing bind. Since <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount</code> failed with "target is busy", we can use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount -l</code> (lazy unmount) or <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount -f</code> (force).</div><div class="paragraph" dir="auto">Let me give the user a clear set of commands:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-l</span> /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev
<span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">If that doesn't work, we'll try the non-chroot approach.</div><div class="paragraph" dir="auto">Actually, let me reconsider the whole approach. The fundamental problem is that SystemRescue's environment has broken <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code>, which means <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> won't work properly either because <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> depends on the kernel's device model which is exposed through <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code>.</div><div class="paragraph" dir="auto">So maybe the best approach is to skip chroot entirely and run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from SystemRescue with the correct paths.</div><div class="paragraph" dir="auto">For an EFI system, the command would be:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi --boot-directory<span class="token operator">=</span>/mnt/parrot/boot /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But wait, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from SystemRescue might not have the right GRUB modules or might not detect the Parrot OS properly.</div><div class="paragraph" dir="auto">Let me think about this more carefully...</div><div class="paragraph" dir="auto">Actually, the user is on a Dell laptop with UEFI (we can see "DELL" at the bottom of the screen). The system is EFI-based. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> inside chroot detected <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">x86_64-efi</code> platform, which is correct.</div><div class="paragraph" dir="auto">The problem is specifically that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> inside chroot doesn't have the device nodes needed by GRUB to map <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> to a physical device.</div><div class="paragraph" dir="auto">I think the best approach is:</div><ol start="1"><li><div class="paragraph" dir="auto">Force unmount the broken <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> bind</div></li><li><div class="paragraph" dir="auto">Mount a fresh devtmpfs</div></li><li><div class="paragraph" dir="auto">Also mount <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> properly</div></li><li><div class="paragraph" dir="auto">Chroot and try again</div></li></ol><div class="paragraph" dir="auto">Or alternatively:</div><ol start="1"><li><div class="paragraph" dir="auto">Skip chroot</div></li><li><div class="paragraph" dir="auto">Use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install --boot-directory=/mnt/parrot/boot --efi-directory=/mnt/parrot/boot/efi --target=x86_64-efi /dev/sda</code></div></li><li><div class="paragraph" dir="auto">Then generate the config using <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig -o /mnt/parrot/boot/grub/grub.cfg</code></div></li></ol><div class="paragraph" dir="auto">Let me go with the non-chroot approach as it's more reliable when the chroot environment is broken.</div><div class="paragraph" dir="auto">Actually, I just realized - <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from outside chroot needs to know where the root partition is to generate the config. But <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">update-grub</code> (or <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code>) needs to run inside the OS environment to detect the kernels and OS properly.</div><div class="paragraph" dir="auto">Hmm, but we can run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> from outside chroot if we set up the environment properly.</div><div class="paragraph" dir="auto">Actually, let me try yet another approach: <strong>manually create the critical device nodes</strong> in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code>. The key device nodes GRUB needs are:</div><ul start="1"><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code> (the disk)</div></li><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda1</code> (EFI partition)</div></li><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda4</code> (Parrot root)</div></li></ul><div class="paragraph" dir="auto">We can create these with <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mknod</code> using the major/minor numbers from <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">ls -l /dev/sda*</code> in SystemRescue.</div><div class="paragraph" dir="auto">But this is getting complicated. Let me try the simplest approach first:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># From outside chroot</span>
grub-install --boot-directory<span class="token operator">=</span>/mnt/parrot/boot --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">If this works, then we can generate the config with:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">grub-mkconfig</span> <span class="token parameter variable">-o</span> /mnt/parrot/boot/grub/grub.cfg</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> might not work properly from outside chroot because it needs to detect the OS, kernels, etc.</div><div class="paragraph" dir="auto">Actually, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> can work from outside chroot if we tell it the right root. But it's designed to run inside the OS.</div><div class="paragraph" dir="auto">OK, let me try a completely different approach. What if we use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">systemd-nspawn</code> instead of <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">chroot</code>? <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">systemd-nspawn</code> properly sets up <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> automatically.</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">systemd-nspawn <span class="token parameter variable">-D</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But SystemRescue might not have <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">systemd-nspawn</code>.</div><div class="paragraph" dir="auto">Let me go back to basics. The issue is that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --bind /dev /mnt/parrot/dev</code> doesn't work because SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> is incomplete. What if we use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind</code> (recursive bind) which should include all sub-mounts?</div><div class="paragraph" dir="auto">Wait, the user already tried <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code> and it didn't help.</div><div class="paragraph" dir="auto">OK, I think the real issue is deeper. SystemRescue is running in a live environment where <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> are not fully populated. When we bind <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> into the chroot, the device nodes in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> depend on <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> being properly mounted in the <strong>host</strong> system. Since SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> are broken, the device nodes in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> are also incomplete.</div><div class="paragraph" dir="auto">The solution is to either:</div><ol start="1"><li><div class="paragraph" dir="auto">Fix SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> first, then bind <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code></div></li><li><div class="paragraph" dir="auto">Mount a fresh <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> in the chroot (but this requires <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> to be mounted in the host)</div></li><li><div class="paragraph" dir="auto">Skip chroot entirely</div></li></ol><div class="paragraph" dir="auto">Let me try approach 1: Fix SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code>.</div><div class="paragraph" dir="auto">Actually, looking at the errors again:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">-bash: /proc/sys/kernel/random/boot_id: No such file or directory
-bash: /proc/sys/kernel/random/uuid: No such file or directory</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">These are bash shell initialization errors. Bash tries to read <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc/sys/kernel/random/boot_id</code> on startup for its <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">$RANDOM</code> seed. The fact that these files don't exist means SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> mount is incomplete.</div><div class="paragraph" dir="auto">But wait - <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">ls /mnt/parrot</code> worked fine earlier, and we could see all the files. So <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> is partially working. The missing files are just <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">boot_id</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">uuid</code> in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc/sys/kernel/random/</code>.</div><div class="paragraph" dir="auto">The device nodes in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> should still exist if <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> is mounted. Let me check if SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code> exists...</div><div class="paragraph" dir="auto">Actually, from the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">lsblk</code> output earlier, we could see all the devices. So <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code> does exist in SystemRescue. The issue is that when we bind <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> into the chroot, the device nodes might not be accessible or might have wrong permissions.</div><div class="paragraph" dir="auto">Hmm, let me think about this differently. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> error says "cannot find a device for /boot/grub". This means GRUB is trying to determine which physical device contains <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code>, and it's failing.</div><div class="paragraph" dir="auto">GRUB uses the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">stat()</code> system call on <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> to get the device major/minor numbers, then looks in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> for a device node with those numbers. If <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> in the chroot doesn't have the right device nodes, this lookup fails.</div><div class="paragraph" dir="auto">So the issue is definitely that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code> doesn't have the proper device nodes for <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda1</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda4</code>, etc.</div><div class="paragraph" dir="auto">When we do <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --bind /dev /mnt/parrot/dev</code>, we should get all of SystemRescue's device nodes. But maybe the bind mount isn't working properly because of the broken <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code>.</div><div class="paragraph" dir="auto">Let me try a different approach: <strong>Use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">cp -a</code> to copy the device nodes</strong> instead of bind-mounting. Device nodes are special files, and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">cp -a</code> should preserve them.</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># Exit chroot</span>
<span class="token builtin class-name">exit</span>

<span class="token comment"># Remove the broken bind mount</span>
<span class="token function">umount</span> <span class="token parameter variable">-l</span> /mnt/parrot/dev

<span class="token comment"># Copy device nodes manually</span>
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/sda* /mnt/parrot/dev/
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/null /mnt/parrot/dev/
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/zero /mnt/parrot/dev/
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/random /mnt/parrot/dev/
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/urandom /mnt/parrot/dev/
<span class="token function">cp</span> <span class="token parameter variable">-a</span> /dev/tty /mnt/parrot/dev/
<span class="token comment"># ... and other needed devices</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But this is tedious and error-prone.</div><div class="paragraph" dir="auto">Actually, a better approach: <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">tar</code> the device nodes and extract them:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">tar</span> <span class="token parameter variable">-cf</span> - <span class="token parameter variable">-C</span> /dev <span class="token builtin class-name">.</span> <span class="token operator">|</span> <span class="token function">tar</span> <span class="token parameter variable">-xf</span> - <span class="token parameter variable">-C</span> /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But this might not work well with special files in a live environment.</div><div class="paragraph" dir="auto">OK, let me try yet another approach. What if the issue is that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> is looking for <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> but the actual path inside the chroot is different? Let me check...</div><div class="paragraph" dir="auto">In the chroot, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> should exist because we mounted the Parrot root at <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot</code> and the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub</code> directory was visible in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/boot</code>. So inside the chroot, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> should exist.</div><div class="paragraph" dir="auto">Wait, I just realized something. Looking at the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">ls -la /mnt/parrot/boot</code> output from earlier, I can see:</div><ul start="1"><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">efi</code> (directory)</div></li><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub</code> (directory)</div></li></ul><div class="paragraph" dir="auto">So <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code> exists inside the chroot. The issue is purely that GRUB can't find the device node for it.</div><div class="paragraph" dir="auto">Let me try the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> approach more carefully. The issue might be that when we did <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code>, it created a recursive bind that includes SystemRescue's broken devtmpfs. We need to unmount this and mount a fresh devtmpfs.</div><div class="paragraph" dir="auto">But <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> failed with "target is busy". This is because something is using that mount point. We need to find what's using it and stop it, or use lazy unmount.</div><div class="paragraph" dir="auto">Actually, looking at the screenshot again, the user ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> and got <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount: /mnt/parrot/dev: target is busy.</code> Then they ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code> on top of the existing mount. So now there are multiple layers of mounts on <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code>.</div><div class="paragraph" dir="auto">We need to unmount all layers. Let me try:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot/dev  <span class="token comment"># recursive unmount</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Or:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> /mnt/parrot/dev
<span class="token function">umount</span> /mnt/parrot/dev  <span class="token comment"># might need multiple times</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Then mount a fresh devtmpfs:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But wait, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> requires the kernel to have <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> mounted to populate device nodes. If SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> is broken, the devtmpfs might also be incomplete.</div><div class="paragraph" dir="auto">Hmm, but SystemRescue's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> is mounted (we can see it in the mount output). The issue is just that some files in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc/sys/kernel/random/</code> are missing. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> filesystem itself should be working.</div><div class="paragraph" dir="auto">Actually, let me re-read the errors. The errors are:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">-bash: /proc/sys/kernel/random/boot_id: No such file or directory
-bash: /proc/sys/kernel/random/uuid: No such file or directory</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">These are bash startup errors. Bash reads these files when it starts. The files don't exist, but that doesn't mean <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> is completely broken. It just means those specific files are missing.</div><div class="paragraph" dir="auto">The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> filesystem should still be working, and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> should still be able to create device nodes because it gets events from the kernel via <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">uevent</code>, not from <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code>.</div><div class="paragraph" dir="auto">So let me try:</div><ol start="1"><li><div class="paragraph" dir="auto">Unmount all layers of <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code></div></li><li><div class="paragraph" dir="auto">Mount a fresh devtmpfs</div></li><li><div class="paragraph" dir="auto">Chroot and try grub-install</div></li></ol><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev
<span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">If <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount -R</code> doesn't work, try lazy unmount:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-lR</span> /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Actually, let me also consider: maybe we should just skip all this chroot complexity and use the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--root-directory</code> option or equivalent.</div><div class="paragraph" dir="auto">For modern GRUB (2.x), the options are:</div><ul start="1"><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--boot-directory=DIR</code> - install GRUB images under DIR/grub</div></li><li><div class="paragraph" dir="auto"><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--efi-directory=DIR</code> - use DIR as the EFI System Partition</div></li></ul><div class="paragraph" dir="auto">So from outside chroot:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi --boot-directory<span class="token operator">=</span>/mnt/parrot/boot /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">This should install the GRUB EFI bootloader to <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/boot/efi/EFI/</code> and the GRUB modules/config to <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/boot/grub/</code>.</div><div class="paragraph" dir="auto">Then for the config:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">grub-mkconfig</span> <span class="token parameter variable">-o</span> /mnt/parrot/boot/grub/grub.cfg</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> might not work properly from outside chroot because it runs scripts in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/etc/grub.d/</code> that might depend on the chroot environment.</div><div class="paragraph" dir="auto">Actually, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig</code> can be run from outside chroot if we specify the right paths. But it's tricky.</div><div class="paragraph" dir="auto">Let me try a hybrid approach:</div><ol start="1"><li><div class="paragraph" dir="auto">Run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from outside chroot</div></li><li><div class="paragraph" dir="auto">Then chroot just to run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">update-grub</code></div></li></ol><div class="paragraph" dir="auto">Or even better:</div><ol start="1"><li><div class="paragraph" dir="auto">Fix the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> mount in chroot</div></li><li><div class="paragraph" dir="auto">Run everything inside chroot</div></li></ol><div class="paragraph" dir="auto">I think fixing <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> is the right approach. Let me give the user a clear command sequence.</div><div class="paragraph" dir="auto">Actually, I just had another idea. What if we use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mknod</code> to create just the essential device nodes we need? We only need <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda1</code>, <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda4</code>, and maybe a few others.</div><div class="paragraph" dir="auto">We can get the major/minor numbers from <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">ls -l /dev/sda*</code> in SystemRescue:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">ls</span> <span class="token parameter variable">-l</span> /dev/sda*</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Then create the nodes in the chroot:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mknod</span> /mnt/parrot/dev/sda b <span class="token number">8</span> <span class="token number">0</span>
<span class="token function">mknod</span> /mnt/parrot/dev/sda1 b <span class="token number">8</span> <span class="token number">1</span>
<span class="token function">mknod</span> /mnt/parrot/dev/sda4 b <span class="token number">8</span> <span class="token number">4</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">But this is getting too complicated. Let me try the simplest approach first.</div><div class="paragraph" dir="auto">OK, I've been overthinking this. Let me give the user a simple, clear set of commands to try:</div><div class="paragraph" dir="auto"><strong>Approach 1: Fix /dev with devtmpfs</strong></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-lR</span> /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev
<span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto"><strong>Approach 2: Skip chroot entirely</strong></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash">grub-install <span class="token parameter variable">--target</span><span class="token operator">=</span>x86_64-efi --efi-directory<span class="token operator">=</span>/mnt/parrot/boot/efi --boot-directory<span class="token operator">=</span>/mnt/parrot/boot /dev/sda
<span class="token function">grub-mkconfig</span> <span class="token parameter variable">-o</span> /mnt/parrot/boot/grub/grub.cfg</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">I'll give them Approach 2 first since it's simpler and avoids the chroot /dev issues entirely. If that doesn't work, we'll try Approach 1.</div><div class="paragraph" dir="auto">Actually wait, I need to be more careful. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> from SystemRescue might not have the same GRUB version as Parrot, and the modules might not be compatible. But since we're installing to the Parrot partition, it should use the GRUB files from Parrot's <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/boot/grub</code>.</div><div class="paragraph" dir="auto">Hmm, actually <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> uses the GRUB files from the system it's running on (SystemRescue), not from the target system. This could be a problem if the GRUB versions are different.</div><div class="paragraph" dir="auto">SystemRescue is Arch-based, and Parrot is Debian-based. They might have different GRUB versions.</div><div class="paragraph" dir="auto">So chroot is actually the safer approach because it uses Parrot's own <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install</code> and GRUB modules.</div><div class="paragraph" dir="auto">OK, let me go back to fixing the chroot <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> issue. The problem is that <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> says "target is busy". This is because the chroot process or something else is holding the mount point open.</div><div class="paragraph" dir="auto">Wait, the user already exited the chroot. So nothing should be using <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code>. But maybe some background process or the shell itself has a file descriptor open to something in <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code>.</div><div class="paragraph" dir="auto">Actually, looking at the screenshot more carefully, after <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">exit</code> from chroot, the user ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">umount /mnt/parrot/dev</code> and got "target is busy". Then they ran <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">mount --rbind /dev /mnt/parrot/dev</code> on top of the existing mount.</div><div class="paragraph" dir="auto">So now there are multiple mount layers on <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot/dev</code>. We need to peel them off.</div><div class="paragraph" dir="auto">Let me try:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> /mnt/parrot/dev  <span class="token comment"># unmount the rbind layer</span>
<span class="token function">umount</span> /mnt/parrot/dev  <span class="token comment"># unmount the original bind layer</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Or use:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">If that doesn't work, lazy unmount:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-lR</span> /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Then mount a fresh devtmpfs:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">And also make sure <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/sys</code> is mounted:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mount</span> <span class="token parameter variable">-t</span> sysfs sysfs /mnt/parrot/sys</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Then chroot:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Let me give the user these commands clearly.</div><div class="paragraph" dir="auto">Actually, I just realized something else. The user might have also mounted <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/proc</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/run</code> with <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">--bind</code>. These might also need to be refreshed. But let's focus on <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> first since that's what GRUB is complaining about.</div><div class="paragraph" dir="auto">OK, final plan:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># Exit chroot if still in it</span>
<span class="token builtin class-name">exit</span>

<span class="token comment"># Unmount all layers of /dev</span>
<span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot/dev

<span class="token comment"># If that fails, try lazy unmount</span>
<span class="token function">umount</span> <span class="token parameter variable">-lR</span> /mnt/parrot/dev

<span class="token comment"># Mount fresh devtmpfs</span>
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /mnt/parrot/dev

<span class="token comment"># Also mount sys properly</span>
<span class="token function">mount</span> <span class="token parameter variable">-t</span> sysfs sysfs /mnt/parrot/sys

<span class="token comment"># Chroot and install GRUB</span>
<span class="token function">chroot</span> /mnt/parrot
grub-install /dev/sda
<span class="token function">update-grub</span>
<span class="token builtin class-name">exit</span>
<span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot
<span class="token function">reboot</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Let me present this clearly to the user. The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev</code> bind mount is broken and busy. Let's force unmount it and use a fresh <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">devtmpfs</code> instead.</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">umount</span> <span class="token parameter variable">-lR</span> /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">-t</span> devtmpfs devtmpfs /</code></pre></div></div> <div data-v-d664c8c3=""></div></div></div> <!----> <!----> <!----></div>  <div data-v-a660adc4="" class="stop-tip-wrapper"><span data-v-a660adc4="" class="stop-tip">Output stopped</span></div> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <!----></div><!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" 