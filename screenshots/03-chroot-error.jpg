9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">I see — after pressing Q, you're back at the partition list but now only showing the `P FAT12` partition. The `P Linux` and `D Linux` partitions from before are gone from this view.</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">This means the partition structure changed when you navigated. Let me think about what's happening:</div><div class="paragraph" dir="auto">The USB was used to flash SystemRescue ISO. When you flashed the ISO, it overwrote the entire USB with the ISO's partition structure. Your personal files that were on the USB before flashing are <strong>likely gone</strong> because the ISO write process overwrites everything.</div><div class="paragraph" dir="auto">The <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">P Linux</code> partition we saw earlier was probably part of the SystemRescue ISO structure, not your old data.</div><hr><h2>The Reality</h2><div class="paragraph" dir="auto">Your USB was <strong>overwritten by the SystemRescue ISO</strong>. The 17GB of personal files you had on it were erased when you flashed the ISO. This is normal — flashing an ISO wipes the entire drive.</div><hr><h2>What You Can Do Now</h2><div class="paragraph" dir="auto">Since the USB data is gone, let's focus on what we CAN control:</div><h3>Option 1: Accept the Loss and Move On</h3><ul start="1"><li><div class="paragraph" dir="auto">You already freed up 25GB in Windows</div></li><li><div class="paragraph" dir="auto">Let's shrink Windows and expand Parrot with that</div></li><li><div class="paragraph" dir="auto">Total Parrot space: ~77GB</div></li></ul><h3>Option 2: Try Deeper Recovery (Low Chance)</h3><div class="paragraph" dir="auto">We could try PhotoRec (comes with TestDisk) to scan for file signatures, but since the ISO overwrote the USB, chances are very low.</div><hr><h2>My Recommendation</h2><div class="paragraph" dir="auto"><strong>Quit TestDisk and let's proceed with expanding Parrot using the 25GB you already freed up.</strong></div><div class="paragraph" dir="auto">You can always get another USB later for backups.</div><div class="paragraph" dir="auto"><strong>Press Q to quit TestDisk, then let's shrink Windows and expand Parrot!</strong> 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 7