"currentColor"></path></svg> <span data-v-351fdc4e="">Copy</span></div> <div data-v-351fdc4e="" data-v-b1bd13bb="" class="simple-button size-small"><svg data-v-351fdc4e="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify simple-button-icon" width="16" height="16" viewBox="0 0 1024 1024" name="Share_a"><path d="M386.218667 247.850667c0-102.4 120.405333-157.397333 197.76-90.282667l304.426666 264.32a119.466667 119.466667 0 0 1 1.365334 179.285333l-304.469334 272.170667c-76.970667 68.778667-199.082667 14.122667-199.082666-89.088v-89.173333c-33.024 2.261333-59.306667 6.826667-83.2 15.36-30.592 10.88-61.866667 29.952-98.602667 67.712a76.8 76.8 0 0 1-131.84-53.504c0-98.645333 24.106667-190.976 83.712-261.888 55.253333-65.792 133.973333-104.789333 229.930667-117.845334V247.850667z m147.413333-32.256c-27.648-23.978667-70.613333-4.352-70.613333 32.256v126.208l-0.256 4.309333c-2.218667 21.504-20.437333 38.186667-42.410667 40.021333l-17.194667 1.706667c-173.994667 20.949333-253.824 136.405333-253.824 304.554667 86.997333-89.557333 163.925333-105.386667 270.933334-107.861334a42.026667 42.026667 0 0 1 42.752 42.24v125.226667c0 34.56 38.272 53.845333 65.706666 35.925333l5.376-4.096 304.426667-272.213333a42.666667 42.666667 0 0 0 2.986667-60.714667l-3.413334-3.285333-304.469333-264.277333z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Share</span></div> <!----></div> <!----></div>   <!----> <!----> <!----> <!----></div></div></div></div><div data-v-38e35b58="" class="chat-content-item chat-content-item-assistant" data-archer-id="19f248f4-cfc2-84a3-8000-0a16a01aba04"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-assistant"><div data-v-88be9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div class="paragraph" dir="auto">Perfect! I can see from the screenshot that <strong>the mount finally worked!</strong> 🎉</div><div class="paragraph" dir="auto">At the bottom of the screen, I can see:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">mount</span> <span class="token parameter variable">-o</span> <span class="token assign-left variable">subvol</span><span class="token operator">=</span>@ /dev/sda4 /mnt/parrot
<span class="token function">ls</span> /mnt/parrot</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">And the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">ls</code> output shows your Parrot OS filesystem is mounted! I can see directories like:
<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">bin  boot  dev  etc  home  initrd.img  initrd.img.old  lib  lib32  lib64  media  mnt  opt  proc  root  run  sbin  srv  sys  tmp  usr  var  vmlinuz  vmlinuz.old</code></div><div class="paragraph" dir="auto">This confirms <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda4</code> is your Parrot root partition and it's successfully mounted at <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/mnt/parrot</code>.</div><hr><h2>✅ Next Steps: Chroot &amp; Reinstall GRUB</h2><div class="paragraph" dir="auto">Now we need to:</div><ol start="1"><li><div class="paragraph" dir="auto">Mount essential virtual filesystems (proc, sys, dev, efivarfs)</div></li><li><div class="paragraph" dir="auto">Chroot into your Parrot system</div></li><li><div class="paragraph" dir="auto">Reinstall GRUB</div></li><li><div class="paragraph" dir="auto">Update GRUB config</div></li><li><div class="paragraph" dir="auto">Exit and reboot</div></li></ol><hr><h2>Run These Commands One by One</h2><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 1. Mount virtual filesystems (needed for chroot to work properly)</span>
<span class="token function">mount</span> <span class="token parameter variable">--bind</span> /dev /mnt/parrot/dev
<span class="token function">mount</span> <span class="token parameter variable">--bind</span> /proc /mnt/parrot/proc
<span class="token function">mount</span> <span class="token parameter variable">--bind</span> /sys /mnt/parrot/sys
<span class="token function">mount</span> <span class="token parameter variable">--bind</span> /run /mnt/parrot/run</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 2. Mount the EFI partition (so GRUB can install to it)</span>
<span class="token comment"># From fdisk, sda1 is 100MB EFI System - that's your EFI partition</span>
<span class="token function">mount</span> /dev/sda1 /mnt/parrot/boot/efi</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 3. Chroot into your Parrot system</span>
<span class="token function">chroot</span> /mnt/parrot</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 4. Reinstall GRUB to the disk (NOT the partition)</span>
grub-install /dev/sda</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 5. Update GRUB configuration</span>
<span class="token function">update-grub</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 6. Exit chroot</span>
<span class="token builtin class-name">exit</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 7. Unmount everything</span>
<span class="token function">umount</span> <span class="token parameter variable">-R</span> /mnt/parrot</code></pre></div></div> <div data-v-d664c8c3=""></div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># 8. Reboot</span>
<span class="token function">reboot</span></code></pre></div></div> <div data-v-d664c8c3=""></div><hr><h2>⚠️ Important Notes</h2><ul start="1"><li><div class="paragraph" dir="auto"><strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install /dev/sda</code></strong> — Install to the <strong>disk</strong> (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code>), not the partition (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda4</code>)</div></li><li><div class="paragraph" dir="auto"><strong><code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda1</code></strong> — Your 100MB EFI System partition (from fdisk output)</div></li><li><div class="paragraph" dir="auto">If <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">update-grub</code> says command not found, try <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-mkconfig -o /boot/grub/grub.cfg</code></div></li></ul><hr><h2>Start with Step 1</h2><div class="paragraph" dir="auto">Type this first:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 1