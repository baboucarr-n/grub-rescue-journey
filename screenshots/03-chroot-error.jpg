M386.218667 247.850667c0-102.4 120.405333-157.397333 197.76-90.282667l304.426666 264.32a119.466667 119.466667 0 0 1 1.365334 179.285333l-304.469334 272.170667c-76.970667 68.778667-199.082667 14.122667-199.082666-89.088v-89.173333c-33.024 2.261333-59.306667 6.826667-83.2 15.36-30.592 10.88-61.866667 29.952-98.602667 67.712a76.8 76.8 0 0 1-131.84-53.504c0-98.645333 24.106667-190.976 83.712-261.888 55.253333-65.792 133.973333-104.789333 229.930667-117.845334V247.850667z m147.413333-32.256c-27.648-23.978667-70.613333-4.352-70.613333 32.256v126.208l-0.256 4.309333c-2.218667 21.504-20.437333 38.186667-42.410667 40.021333l-17.194667 1.706667c-173.994667 20.949333-253.824 136.405333-253.824 304.554667 86.997333-89.557333 163.925333-105.386667 270.933334-107.861334a42.026667 42.026667 0 0 1 42.752 42.24v125.226667c0 34.56 38.272 53.845333 65.706666 35.925333l5.376-4.096 304.426667-272.213333a42.666667 42.666667 0 0 0 2.986667-60.714667l-3.413334-3.285333-304.469333-264.277333z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Share</span></div> <!----></div> <!----></div>   <!----> <!----> <!----> <!----></div></div></div></div><div data-v-38e35b58="" class="chat-content-item chat-content-item-assistant" data-archer-id="19f5c6b5-30a2-8fae-8000-0a1640c0b46b"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-assistant"><div data-v-88be9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">Yes, absolutely possible! Here's the safe approach:</code></pre></div></div> <div data-v-d664c8c3=""></div><hr><h2>The Plan</h2><ol start="1"><li><div class="paragraph" dir="auto"><strong>Reset Windows</strong> → This wipes the Windows partition but leaves Parrot untouched</div></li><li><div class="paragraph" dir="auto"><strong>Shrink the fresh Windows partition</strong> → Free up space</div></li><li><div class="paragraph" dir="auto"><strong>Expand Parrot partition</strong> → Grow into the freed space</div></li></ol><hr><h2>⚠️ Critical: Back Up Parrot First</h2><div class="paragraph" dir="auto">Even though this is safe, always backup:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token comment"># In Parrot, open terminal and run:</span>
<span class="token function">sudo</span> btrfs subvolume snapshot / /mnt/backup-snapshot</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">Or copy important files to an external drive.</div><hr><h2>Step-by-Step</h2><h3>Step 1: Reset Windows</h3><ul start="1"><li><div class="paragraph" dir="auto">Boot into Windows</div></li><li><div class="paragraph" dir="auto">Go to <strong>Settings → System → Recovery → Reset this PC</strong></div></li><li><div class="paragraph" dir="auto">Choose <strong>"Keep my files"</strong> or <strong>"Remove everything"</strong> — either is fine</div></li><li><div class="paragraph" dir="auto">This only affects the Windows partition (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda3</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda5</code>)</div></li></ul><blockquote><div class="paragraph" dir="auto">✅ <strong>Parrot partition (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda4</code>) will NOT be touched</strong></div></blockquote><h3>Step 2: After Windows Reset, Shrink Windows Partition</h3><div class="paragraph" dir="auto">Once Windows is fresh and running:</div><ol start="1"><li><div class="paragraph" dir="auto">Disable <strong>Fast Startup</strong> (Control Panel → Power Options)</div></li><li><div class="paragraph" dir="auto">Open <strong>Disk Management</strong> (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">Win + X</code> → Disk Management)</div></li><li><div class="paragraph" dir="auto">Right-click <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">C:</code> drive → <strong>Shrink Volume</strong></div></li><li><div class="paragraph" dir="auto">Shrink by however much you want to give to Parrot (e.g., 50GB = 51200 MB)</div></li></ol><div class="paragraph" dir="auto">This creates <strong>unallocated space</strong> next to Parrot.</div><h3>Step 3: Expand Parrot Partition</h3><div class="paragraph" dir="auto">Now boot from your <strong>SystemRescue USB</strong>:</div><ol start="1"><li><div class="paragraph" dir="auto">Boot SystemRescue → <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">startx</code> for GUI</div></li><li><div class="paragraph" dir="auto">Open <strong>GParted</strong></div></li><li><div class="paragraph" dir="auto">Right-click <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda4</code> (Parrot, BTRFS) → <strong>Resize/Move</strong></div></li><li><div class="paragraph" dir="auto">Drag right edge to fill the unallocated space</div></li><li><div class="paragraph" dir="auto">Click <strong>Resize/Move</strong> → Apply (green checkmark)</div></li><li><div class="paragraph" dir="auto">Reboot, remove USB</div></li></ol><h3>Step 4: Verify Parrot Still Boots</h3><div class="paragraph" dir="auto">You should see the GRUB menu with both Parrot and Windows. Boot into Parrot and check everything works.</div><hr><h2>⚠️ Important Notes</h2><div data-v-01af594f="" data-v-3b9ae98b="" class="table markdown-table"><div data-v-13fde6a9="" data-v-01af594f="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-01af594f="" class="table-actions"><div data-v-01af594f="" class="table-actions-content"><span data-v-01af594f="" class="table-title">Table</span> <span data-v-868ea423="" data-v-01af594f=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span> <div data-v-1005b780="" data-v-01af594f="" class="icon-button table-actions-icon" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Download"><path d="M512 126.976a36.864 36.864 0 0 1 36.864 36.864v347.91424l119.11168-119.11168a36.864 36.864 0 1 1 52.14208 52.14208l-182.0672 182.02624a36.864 36.864 0 0 1-52.10112 0l-182.0672-182.02624a36.864 36.864 0 0 1 52.14208-52.14208l119.11168 119.11168V163.84a36.864 36.864 0 0 1 36.864-36.864zM184.32 564.71552a36.864 36.864 0 0 1 36.864 36.864v145.65376a35.96288 35.96288 0 0 0 35.96288 35.96288h509.70624a35.96288 35.96288 0 0 0 35.96288-35.96288v-145.65376a36.864 36.864 0 0 1 73.728 0v145.65376a109.69088 109.69088 0 0 1-109.69088 109.69088H257.14688A109.69088 109.69088 0 0 1 147.456 747.23328v-145.65376a36.864 36.864 0 0 1 36.864-36.864z" fill="currentColor"></path></svg> <!----></div><!----></div></header></div></div></div> <div data-v-01af594f="" class="table-container"><table data-v-01af594f=""><thead data-v-01af594f=""><tr data-v-01af594f=""><th data-v-01af594f="" align="left">Concern</th><th data-v-01af594f="" align="left">Answer</th></tr></thead> <tbody data-v-01af594f=""><tr data-v-01af594f=""><td data-v-01af594f="" align="left">Will resetting Windows delete Parrot?</td><td data-v-01af594f="" align="left"><strong data-v-01af594f="">No</strong> — Windows reset only touches its own partitions</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left">Will expanding Parrot delete data?</td><td data-v-01af594f="" align="left"><strong data-v-01af594f="">No</strong> — GParted expands into empty space without touching existing data</td></tr><tr data-v-01af594f=""><td data-v-01af594f="" align="left">Could GRUB break again?</td><td data-v-01af594f="" align="left"><strong data-v-01af594f="">Possibly</strong> — Windows reset might overwrite the EFI bootloader. If Parrot doesn't boot, boot SystemRescue again and re-run <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">grub-install /dev/sda</code> + <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">update-grub</code></td></tr></tbody></table></div></div><hr><h2>Quick Summary</h2><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">Reset Windows → Shrink Windows in Disk Management → Boot SystemRescue → GParted expand sda4 → Done!</code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto"><strong>Want me to walk you through any specific step?</strong> 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-