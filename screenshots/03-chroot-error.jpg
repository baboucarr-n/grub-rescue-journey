667 1.706667c-173.994667 20.949333-253.824 136.405333-253.824 304.554667 86.997333-89.557333 163.925333-105.386667 270.933334-107.861334a42.026667 42.026667 0 0 1 42.752 42.24v125.226667c0 34.56 38.272 53.845333 65.706666 35.925333l5.376-4.096 304.426667-272.213333a42.666667 42.666667 0 0 0 2.986667-60.714667l-3.413334-3.285333-304.469333-264.277333z" fill="currentColor"></path></svg> <span data-v-351fdc4e="">Share</span></div> <!----></div> <!----></div>   <!----> <!----> <!----> <!----></div></div></div></div><div data-v-38e35b58="" class="chat-content-item chat-content-item-assistant" data-archer-id="19f5ceed-e702-8531-8000-0a16aa8fd8a8"><!----> <div data-v-a660adc4="" data-v-38e35b58="" class="segment segment-assistant"><div data-v-88be9e2e="" data-v-a660adc4="" class="segment-avatar"><div data-v-88be9e2e="" class="avatar"><canvas data-v-b81624a4="" data-v-88be9e2e="" style="width: 56px; height: 56px;" class="rive-container" width="112" height="112"></canvas></div></div> <div data-v-a660adc4="" class="segment-container" dir="auto"> <!----> <!----> <div data-v-a660adc4="" class="segment-content"><div data-v-a660adc4="" class="segment-content-box"> <!----> <div data-v-3b9ae98b="" data-v-d664c8c3="" class="markdown-container"><div data-v-3b9ae98b="" class="markdown"><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">plain</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-plain"><code class="language-plain">Great! You freed up 25GB in Windows. Now let's add that space to Parrot.</code></pre></div></div> <div data-v-d664c8c3=""></div><hr><h2>Steps to Expand Parrot</h2><h3>Option A: Use AOMEI Partition Assistant (Easiest)</h3><div class="paragraph" dir="auto">Since you already have AOMEI open:</div><ol start="1"><li><div class="paragraph" dir="auto"><strong>Right-click <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">C:</code> drive</strong> → <strong>Resize/Move Partition</strong></div></li><li><div class="paragraph" dir="auto"><strong>Drag the right edge left</strong> by 25GB (or enter the amount)</div></li><li><div class="paragraph" dir="auto">Click <strong>OK</strong></div></li><li><div class="paragraph" dir="auto">Now you'll have <strong>25GB unallocated space</strong> next to Parrot</div></li><li><div class="paragraph" dir="auto"><strong>Right-click the 52.19GB Parrot partition</strong> → <strong>Resize/Move Partition</strong></div></li><li><div class="paragraph" dir="auto"><strong>Drag the right edge</strong> to fill the unallocated space</div></li><li><div class="paragraph" dir="auto">Click <strong>OK</strong></div></li><li><div class="paragraph" dir="auto">Click <strong>Apply</strong> (top left) → <strong>Proceed</strong></div></li></ol><blockquote><div class="paragraph" dir="auto">⚠️ AOMEI might warn about BTRFS. If it does, use <strong>Option B</strong> below.</div></blockquote><hr><h3>Option B: Use SystemRescue + GParted (Safer for BTRFS)</h3><div class="paragraph" dir="auto">If AOMEI can't handle BTRFS properly:</div><ol start="1"><li><div class="paragraph" dir="auto"><strong>Boot from your SystemRescue USB</strong></div></li><li><div class="paragraph" dir="auto">Type <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">startx</code> for GUI</div></li><li><div class="paragraph" dir="auto">Open <strong>GParted</strong></div></li><li><div class="paragraph" dir="auto">Select <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/dev/sda</code></div></li><li><div class="paragraph" dir="auto"><strong>Right-click <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda3</code> (Windows, NTFS)</strong> → <strong>Resize/Move</strong></div></li><li><div class="paragraph" dir="auto">Shrink by 25GB → click <strong>Resize/Move</strong></div></li><li><div class="paragraph" dir="auto"><strong>Right-click <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">sda4</code> (Parrot, BTRFS)</strong> → <strong>Resize/Move</strong></div></li><li><div class="paragraph" dir="auto">Drag right edge to fill unallocated space → click <strong>Resize/Move</strong></div></li><li><div class="paragraph" dir="auto">Click <strong>Apply</strong> (green checkmark)</div></li><li><div class="paragraph" dir="auto">Reboot, remove USB</div></li></ol><hr><h2>After Expanding Parrot</h2><div class="paragraph" dir="auto">Boot into Parrot and verify:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">bash</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-bash"><code class="language-bash"><span class="token function">df</span> <span class="token parameter variable">-h</span></code></pre></div></div> <div data-v-d664c8c3=""></div><div class="paragraph" dir="auto">You should see your root partition (<code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">/</code>) is now ~77GB instead of 52GB!</div><hr><div class="paragraph" dir="auto"><strong>Which method do you want to use — AOMEI or SystemRescue GParted?</strong> 🚀</div></div></div> <!----> <!----> <!----></div>  <!----> <!----> <!----> <!---->   <!----> <div data-v-38e35b58="" class="okc-cards-container"><!----> <!----> <!----> <!----> <!----></div> <!----> <!----> <!----> <div data-v-b1bd13bb="" data-v-a660adc4="" class="segment-assistant-actions"><div data-v-b1bd13bb="" class="segment-assistant-actions-content"> <!----> <!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <!----></div><!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Refresh"><path d="M303.104 315.392c114.688-114.688 303.104-114.688 417.792 0l-32.768 32.768c-20.48 20.48-4.096 57.344 24.576 57.344h118.784c16.384 0 32.768-16.384 32.768-32.768V253.952c0-28.672-36.864-45.056-57.344-24.576l-32.768 32.768c-143.36-143.36-376.832-143.36-520.192 0s-143.36 376.832 0 520.192 376.832 143.36 520.192 0c49.152-49.152 77.824-106.496 94.208-163.84 4.096-20.48-8.192-40.96-24.576-45.056-20.48-4.096-40.96 8.192-45.056 24.576-12.288 49.152-36.864 94.208-77.824 131.072-114.688 114.688-303.104 114.688-417.792 0-114.688-110.592-114.688-299.008 0-413.696z" fill="currentColor"></path></svg> <!----></div><!----> <!----><div data-v-1005b780="" data-v-b1bd13bb="" class="icon-button" style="width: 28px; height: 28px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="16" height="16" viewBox="0 0 1024 1024" name="Share_a"><path d="M386.218667 247.850667c0-102.4 120.405333-157.397333 197.76-90.282667l304.426666 264.32a119.466667 119.466667 0 0 1 1.365334 179.285333l-304.469334 272.170667c-76.970667 68.778667-199.082667 14.122667-199.082666-89.088v-89.173333c-33.024 2.261333-59.306667 6.826667-83.2 15.36-30.592 10.88-61.866667 29.952-98.602667 67.712a76.8 76.8 0 0 1-131.84-53.504c0-98.645333 24.106667-190.976 83.712-261.888 55.253333-65.792 133.973333-104.789333 229.930667-117.845334V247.850667z m147.413333-32.256c-27.648-23.978667-70.613333-4.352-70.613333 32.256v126.208l-0.256 4.309333c-2.218667 21.504-20.437333 38.186667-42.410667 40.021333l-17.194667 1.706667c-173.994667 20.949333-253.824 136.405333-253.824 304.554667 86.997333-89.557333 163.925333-105.38666